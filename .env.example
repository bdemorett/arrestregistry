# Google Analytics 4 measurement ID (Admin > Data streams > Web). Example: G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=

# Google Search Console HTML-tag verification code (only the content="..." value).
# Leave blank if you verify with a DNS TXT record instead (recommended).
NEXT_PUBLIC_GSC_VERIFICATION=

# Bing Webmaster Tools verification code (msvalidate.01 content value). Optional.
NEXT_PUBLIC_BING_VERIFICATION=

# People-search affiliate tracking link. The search CTA stays hidden until this is set.
NEXT_PUBLIC_AFFILIATE_URL=
# Brand name shown on the CTA button, e.g. BeenVerified
NEXT_PUBLIC_AFFILIATE_NAME=
